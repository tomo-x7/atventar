# Defaults to the browser's origin. Keep empty for same-origin Cloudflare deployment.
VITE_APPVIEW_URL=
VITE_APP_ORIGIN=
# Defaults to /oauth-client-metadata.json on the public app origin.
VITE_OAUTH_CLIENT_ID=
# Vite development proxy target; this value is not exposed to the browser.
APPVIEW_DEV_ORIGIN=http://127.0.0.1:8787
