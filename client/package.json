{
	"name": "client",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"lexgen": "lex build --lexicons ../lexicons --out src/lexicons --clear --index-file",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "node --import tsx --test --test-isolation=none src/**/*.test.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@atpassport/client": "0.2.3",
		"@atproto/lex": "0.4.7",
		"@atproto/oauth-client-browser": "0.5.10",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@storybook/addon-a11y": "10.6.5",
		"@storybook/react-vite": "10.6.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"storybook": "10.6.5",
		"tsx": "^4.23.15",
		"typescript": "~7.0.2",
		"vite": "^8.3.6"
	}
}
